# --- Shared / unprefixed (documented exceptions to the PS_<SLUG>_* convention) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
MANDATE_HMAC_KEY=changeme-local-dev-only
MANDATE_HMAC_KEY_PREVIOUS=
INTERNAL_TICK_SECRET=changeme-local-dev-only

# --- Local docker-compose default (Profile A) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/safepayai
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8001

# --- Per-service PS_<SLUG>_* vars ---
# Each service's full, authoritative env var list lives in services/<slug>/.env.example
# (generated from that service's own deployment.md). This root file covers only the vars
# docker-compose itself needs plus the shared exceptions above. Merging the full per-service
# lists into one working root .env for `docker compose up` is a Wave 5 task, not yet done —
# for now, copy each service's own .env.example values in as needed for local testing.
