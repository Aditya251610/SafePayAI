# resolution service — names only, no real values (per deployment.md section 3 env table).
PS_RESOLUTION_DATABASE_URL=
PS_RESOLUTION_DB_POOL_SIZE=2
PS_RESOLUTION_TRANSPORT=http
PS_RESOLUTION_SERVICE_ID=resolution
PS_RESOLUTION_INTERNAL_JWT_SIGNING_KEY=
PS_RESOLUTION_INTERNAL_JWT_KID=
PS_RESOLUTION_INTERNAL_JWT_TRUSTED_ISSUERS=
PS_RESOLUTION_MANDATE_URL=
PS_RESOLUTION_CHECKOUT_URL=
PS_RESOLUTION_TRACKING_URL=
PS_RESOLUTION_TRIAGE_AI_URL=
PS_RESOLUTION_PAYPAL_ADAPTER_URL=
PS_RESOLUTION_AUDIT_URL=
PS_RESOLUTION_APPROVAL_LINK_HMAC_KEY=
PS_RESOLUTION_APPROVAL_LINK_TTL_S=86400
PS_RESOLUTION_APPROVAL_BASE_URL=
PS_RESOLUTION_POLICY_VERSION=v1
PS_RESOLUTION_POLICY_REFUND_CAP_MINOR=5000
PS_RESOLUTION_POLICY_EXCLUDED_CATEGORIES=
PS_RESOLUTION_POLICY_VELOCITY_MAX=2
PS_RESOLUTION_POLICY_VELOCITY_WINDOW_DAYS=30
PS_RESOLUTION_TRIAGE_MIN_CONFIDENCE=0.7
PS_RESOLUTION_TRIAGE_TIMEOUT_S=4
PS_RESOLUTION_ADAPTER_TIMEOUT_S=10
PS_RESOLUTION_PREAUTH_AUTO_EXECUTE=false
# Must be true; this value only seeds the first control_flags row and can never unfreeze
# an existing one (deployment.md section 7). The kill switch itself lives in the DB, not here.
PS_RESOLUTION_REFUNDS_FROZEN_DEFAULT=true
PS_RESOLUTION_FLAG_CACHE_TTL_S=5
PS_RESOLUTION_RECONCILE_INTERVAL_S=300
PS_RESOLUTION_REFUND_MIN_RECONCILE_AGE_S=60
PS_RESOLUTION_RECONCILE_MAX_ATTEMPTS=10
PS_RESOLUTION_OUTBOX_RELAY_INTERVAL_S=15
PS_RESOLUTION_HUMAN_REVIEW_SLA_TARGET_S=
PS_RESOLUTION_CASE_REPORT_MAX_CHARS=4000
PS_RESOLUTION_TICK_SECRET=
PS_RESOLUTION_DEMO_MODE=true
PS_RESOLUTION_LOG_LEVEL=INFO
