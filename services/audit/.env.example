# audit service -- this service's own vars only. Names match
# .claude/prd/services/audit/{spec.md sec 15, deployment.md sec 4} exactly.
# Placeholders only -- never put real values here (context-brief.md sec 5).
# PAYPAL_* and LLM_API_KEY must NEVER appear in this file (CI env-manifest test,
# deployment.md sec 4 "Secret hygiene").

# Pooled Neon endpoint, audit_app role (platform secret).
PS_AUDIT_DATABASE_URL=postgresql+asyncpg://audit_app:changeme@localhost:5432/artiq

# Direct Neon endpoint, audit_owner/mig_audit role. CI/migration-only -- must never be
# set together with PS_AUDIT_DATABASE_URL in a running service's env (spec.md sec 8).
PS_AUDIT_MIGRATE_DATABASE_URL=

# Small pool size (chain append is already serialized by the advisory lock).
PS_AUDIT_DB_POOL_MAX=5

# Constant chain identifier for this environment.
PS_AUDIT_CHAIN_ID=ps-demo-1

# dev|ci|demo|prod -- guards scripts/tamper_demo.py from running on prod.
PS_AUDIT_ENV=dev

# Static trusted-issuer public-key map: inline JSON or a filesystem path. Empty/unset
# falls back to app/auth_fixtures/local_jwks.json for standalone Wave 4 runs.
PS_AUDIT_TRUSTED_ISSUERS=

# File path of the (producer, event_type, actor_type) emission allowlist.
PS_AUDIT_EMISSION_ALLOWLIST_PATH=

# Ed25519 private key for signed head export (secret, optional P1).
PS_AUDIT_HEAD_SIGNING_KEY=
# Key id exposed alongside the signature in GET /head.
PS_AUDIT_HEAD_SIGNING_KEY_ID=

# Verify keyset chunk size.
PS_AUDIT_VERIFY_CHUNK=500

# Bounded retry count on lock/linkage errors during append.
PS_AUDIT_APPEND_MAX_RETRIES=3

# Max AG Grid page size.
PS_AUDIT_PAGE_MAX=100

# Expected `aud` claim on inbound internal service JWTs.
PS_AUDIT_INTERNAL_AUDIENCE=audit

# Logging level.
PS_AUDIT_LOG_LEVEL=INFO

# FLAGGED (not in spec.md sec 15 / deployment.md sec 4, but referenced by api.md sec 1
# as "PS_AUDIT_BATCH_MAX envelopes" for POST /internal/events/batch): added here with a
# default in app/settings.py so the batch cap is configurable; a doc owner should add
# this name to spec.md/deployment.md's env tables to close the gap.
PS_AUDIT_BATCH_MAX=100
