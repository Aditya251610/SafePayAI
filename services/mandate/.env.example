# mandate - env var names only, placeholders, no real secrets.
# Names taken verbatim from .claude/prd/services/mandate/{spec,deployment}.md.
# MANDATE_HMAC_KEY[_PREVIOUS] and INTERNAL_TICK_SECRET are the settled bare-name
# exceptions (spec.md section 12 C5 / docs/service-skeleton-conventions.md section 2).

PS_MANDATE_APP_ENV=local
PS_MANDATE_LOG_LEVEL=INFO
PORT=8000
PS_MANDATE_DATABASE_URL=postgresql+asyncpg://svc_mandate:changeme@localhost:5432/artiq
PS_MANDATE_DB_POOL_SIZE=2
PS_MANDATE_MIGRATION_DATABASE_URL=postgresql+asyncpg://mig_mandate:changeme@localhost:5432/artiq

MANDATE_HMAC_KEY=changeme-generate-a-256-bit-random-key
MANDATE_HMAC_KEY_PREVIOUS=
PS_MANDATE_HMAC_KEY_ID=k1
PS_MANDATE_HMAC_KEY_ID_PREVIOUS=

PS_MANDATE_INTERNAL_JWT_AUDIENCE=mandate
PS_MANDATE_TRUSTED_ISSUERS=
PS_MANDATE_INTERNAL_JWKS_URL=

PS_MANDATE_POLICY_VERSION=policy.v1
PS_MANDATE_CURRENCY=USD

PS_MANDATE_MAX_TOTAL_CEILING_MINOR=100000
PS_MANDATE_DEFAULT_MAX_QTY_PER_LINE=5
PS_MANDATE_MAX_QTY_PER_LINE_CEILING=20
PS_MANDATE_MAX_MERCHANTS=5
PS_MANDATE_INTENT_MAX_CHARS=500

PS_MANDATE_MIN_EXPIRY_SECONDS=3600
PS_MANDATE_MAX_EXPIRY_SECONDS=2592000

PS_MANDATE_REFUND_CAP_CEILING_MINOR=50000
PS_MANDATE_DELIVER_BY_DAYS_MIN=1
PS_MANDATE_DELIVER_BY_DAYS_MAX=30

PS_MANDATE_NONCE_TTL_SECONDS=120
PS_MANDATE_IDEMPOTENCY_TTL_SECONDS=86400

PS_MANDATE_RESERVATION_TTL_SECONDS=900
PS_MANDATE_STUCK_CAPTURE_ALERT_SECONDS=600
PS_MANDATE_EXHAUST_DUST_MINOR=0

PS_MANDATE_LOCK_TIMEOUT_MS=3000
PS_MANDATE_STATEMENT_TIMEOUT_MS=10000

PS_MANDATE_ADVISORY_NEAR_CAP_PERCENT=90
PS_MANDATE_ADVISORY_EXPIRES_SOON_SECONDS=3600

PS_MANDATE_SIGNING_ENABLED=true

PS_MANDATE_AUDIT_BASE_URL=
PS_MANDATE_CHECKOUT_BASE_URL=
PS_MANDATE_RESOLUTION_BASE_URL=
PS_MANDATE_INPROCESS_TRANSPORT=false
PS_MANDATE_OUTBOX_FLUSH_INTERVAL_SECONDS=30

INTERNAL_TICK_SECRET=changeme-shared-cron-secret
