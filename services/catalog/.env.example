# catalog - env var names only, placeholders, no real secrets.
# Names taken verbatim from .claude/prd/services/catalog/{spec,deployment}.md.

PS_CATALOG_SERVICE_NAME=catalog
PORT=8000
PS_CATALOG_DATABASE_URL=postgresql+asyncpg://svc_catalog:changeme@localhost:5432/artiq
PS_CATALOG_SEED_DATABASE_URL=postgresql+asyncpg://mig_catalog:changeme@localhost:5432/artiq
PS_CATALOG_MIGRATION_DATABASE_URL=postgresql+asyncpg://mig_catalog:changeme@localhost:5432/artiq
PS_CATALOG_SEED_ON_START=true
PS_CATALOG_ADMIN_ENABLED=false
PS_CATALOG_SEED_FILE=app/seed/catalog_seed.json
PS_CATALOG_MAX_LINES=20
PS_CATALOG_MAX_LINE_QTY=10
PS_CATALOG_INTERNAL_JWKS_URL=
PS_CATALOG_INTERNAL_JWT_AUDIENCE=catalog
PS_CATALOG_INTERNAL_CALLER_ALLOWLIST=
PS_CATALOG_LOG_LEVEL=INFO
PS_CATALOG_DB_POOL_SIZE=2
# Local/CI-only convenience: password set on bootstrap roles mig_catalog/svc_catalog
# by migrations/versions/0003_categories_view_and_dev_passwords.py (matches the
# placeholder password already used above). Production provisioning sets a real
# password out of band and never reads this var.
PS_CATALOG_DEV_DB_PASSWORD=changeme
