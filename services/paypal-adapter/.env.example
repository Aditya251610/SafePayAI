# paypal-adapter -- placeholders only, no real secrets. Names match
# spec.md section 12 / deployment.md section 2 exactly. Never commit real values.
# Sandbox only: PS_PAYPALADAPTER_PAYPAL_MODE must be "sandbox"; the startup guard refuses to
# start otherwise (spec.md section 9).

# Deliberate bare-name exception (spec.md section 12): already used in the tested sandbox
# spike script and the real .env; never renamed to PS_PAYPALADAPTER_*.
PAYPAL_CLIENT_ID=changeme
PAYPAL_CLIENT_SECRET=changeme

PS_PAYPALADAPTER_SERVICE_NAME=paypal-adapter
PS_PAYPALADAPTER_LOG_LEVEL=info
PS_PAYPALADAPTER_TRACE_HEADER=X-Trace-Id

PS_PAYPALADAPTER_PAYPAL_MODE=sandbox
PS_PAYPALADAPTER_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PS_PAYPALADAPTER_PAYPAL_TIMEOUT_SECONDS=10
PS_PAYPALADAPTER_PAYPAL_MAX_CONCURRENCY=4
PS_PAYPALADAPTER_PAYPAL_GET_RETRIES=2
PS_PAYPALADAPTER_PAYPAL_TOKEN_REFRESH_SKEW_SECONDS=60
PS_PAYPALADAPTER_PAYPAL_RETURN_URL_ALLOWED_ORIGINS=http://localhost:3000

PS_PAYPALADAPTER_DATABASE_URL=postgresql+asyncpg://svc_paypal:changeme@localhost:5432/artiq
# Not explicitly listed in deployment.md's env table (only PS_PAYPALADAPTER_DATABASE_URL is);
# added for Alembic's direct connection per data-architecture.md section 8. Flagged.
PS_PAYPALADAPTER_MIGRATION_DB_URL=postgresql+asyncpg://mig_paypal:changeme@localhost:5432/artiq

PS_PAYPALADAPTER_INTERNAL_JWKS_URL=http://localhost:8080/.well-known/jwks.json
PS_PAYPALADAPTER_INTERNAL_TRUSTED_ISSUERS=changeme
PS_PAYPALADAPTER_SERVICE_NAME=paypal-adapter
PS_PAYPALADAPTER_INTERNAL_JWT_AUD=paypal-adapter

# Minter-named ticket keys, consumed here for verification (spec.md section 5.4/12).
PS_CHECKOUT_TICKET_HMAC_KEY=changeme
PS_RESOLUTION_TICKET_HMAC_KEY=changeme
PS_CHECKOUT_TICKET_HMAC_KID=changeme
PS_RESOLUTION_TICKET_HMAC_KID=changeme

PS_PAYPALADAPTER_TICKET_TTL_SECONDS=120
PS_PAYPALADAPTER_TICKET_SKEW_SECONDS=10

PS_PAYPALADAPTER_MONEY_ENABLED=false
PS_PAYPALADAPTER_REFUND_MAX_MINOR=50000
PS_PAYPALADAPTER_CALLER_ALLOWLIST_JSON=

PS_PAYPALADAPTER_RATE_LIMIT_READ_PER_MIN=120
PS_PAYPALADAPTER_RATE_LIMIT_MONEY_PER_MIN=30

PS_PAYPALADAPTER_AUDIT_PUSH_URL=http://localhost:8000
PS_PAYPALADAPTER_OUTBOX_FLUSH_SECRET=changeme

PS_PAYPALADAPTER_WEBHOOK_ENABLED=false
PS_PAYPALADAPTER_PAYPAL_WEBHOOK_ID=

PS_PAYPALADAPTER_DEMO_INSPECTOR_ENABLED=false
