# api-gateway - env var names only, placeholders, no real secrets.
# Names taken verbatim from .claude/prd/services/api-gateway/{spec,deployment}.md
# section 13 / section 5. SEED_* passwords are read only by scripts/seed, never by
# the running app, so they are intentionally absent here.

PS_APIGATEWAY_APP_ENV=local
PS_APIGATEWAY_DEMO_MODE=false
PS_APIGATEWAY_LOG_LEVEL=INFO
PORT=8000

PS_APIGATEWAY_DATABASE_URL=postgresql+asyncpg://svc_apigateway:changeme@localhost:5432/artiq
PS_APIGATEWAY_MIGRATION_DATABASE_URL=postgresql+asyncpg://mig_apigateway:changeme@localhost:5432/artiq

PS_APIGATEWAY_FRONTEND_ORIGINS=http://localhost:3000
PS_APIGATEWAY_COOKIE_NAME=__Host-ps_sid
PS_APIGATEWAY_SESSION_TTL_BUYER_S=7200
PS_APIGATEWAY_SESSION_CAP_BUYER_S=28800
PS_APIGATEWAY_SESSION_TTL_STAFF_S=3600
PS_APIGATEWAY_MAX_EPHEMERAL_BUYERS=500

PS_APIGATEWAY_CSRF_KEY=changeme-generate-a-random-key
PS_APIGATEWAY_SESSION_COOKIE_KEY=

PS_APIGATEWAY_SIGNING_KEY_PEM=
PS_APIGATEWAY_SIGNING_KID=k1
PS_APIGATEWAY_PREVIOUS_PUBLIC_KEYS=
PS_APIGATEWAY_INTERNAL_TOKEN_TTL_S=60

PS_APIGATEWAY_UPSTREAM_MODE=http
PS_APIGATEWAY_UPSTREAM_MANDATE_URL=http://localhost:8001
PS_APIGATEWAY_UPSTREAM_CATALOG_URL=http://localhost:8002
PS_APIGATEWAY_UPSTREAM_SHOPPING_AGENT_URL=
PS_APIGATEWAY_UPSTREAM_CHECKOUT_URL=
PS_APIGATEWAY_UPSTREAM_TRACKING_URL=
PS_APIGATEWAY_UPSTREAM_RESOLUTION_URL=
PS_APIGATEWAY_UPSTREAM_AUDIT_URL=

PS_APIGATEWAY_UPSTREAM_CONNECT_TIMEOUT_S=5
PS_APIGATEWAY_UPSTREAM_READ_TIMEOUT_S=10
PS_APIGATEWAY_UPSTREAM_TOTAL_BUDGET_S=100
PS_APIGATEWAY_UPSTREAM_RETRIES=1

PS_APIGATEWAY_MAX_BODY_BYTES=1000000
PS_APIGATEWAY_RATE_LIMIT_AUTH_PER_MIN=10
PS_APIGATEWAY_LLM_DAILY_BUDGET_CALLS=500

PS_APIGATEWAY_MONEY_ROUTES_ENABLED=true
PS_APIGATEWAY_TICK_SECRET=changeme-shared-cron-secret
PS_APIGATEWAY_TRUSTED_PROXY_COUNT=0
PS_APIGATEWAY_APPROVAL_URL_HOST_ALLOWLIST=

PS_APIGATEWAY_SENTRY_DSN=

