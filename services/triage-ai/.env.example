# triage-ai service — names only, no real values (per deployment.md section 4 / spec.md
# section 12 env tables). Provider secrets are read only inside the shared `ai` process env
# in Profile B; never commit real values here.
PS_TRIAGEAI_DATABASE_URL=
PS_TRIAGEAI_LLM_ENABLED=true
PS_TRIAGEAI_MIN_CONFIDENCE=0.7
PS_TRIAGEAI_MAX_TEXT_CHARS=1000
PS_TRIAGEAI_PROMPT_VERSION=v1
PS_TRIAGEAI_TIMEOUT_CLASSIFY_S=4
PS_TRIAGEAI_TIMEOUT_DRAFT_S=6
PS_TRIAGEAI_TIMEOUT_BRIEF_S=10
PS_TRIAGEAI_STALE_WINDOW_HOURS=
PS_TRIAGEAI_MAX_CALLS_PER_CASE=6
PS_TRIAGEAI_CACHE_TTL_HOURS=24
PS_TRIAGEAI_DEBUG_LOG_PROMPTS=false
PS_TRIAGEAI_LLM_PROVIDER_PRIMARY=groq
PS_TRIAGEAI_LLM_PROVIDER_FALLBACK=gemini
PS_TRIAGEAI_LLM_MODEL_TRIAGE_PRIMARY=
PS_TRIAGEAI_LLM_MODEL_TRIAGE_FALLBACK=
PS_TRIAGEAI_GEMINI_API_KEY=
PS_TRIAGEAI_GROQ_API_KEY=
PS_TRIAGEAI_INTERNAL_JWKS_URL=
PS_TRIAGEAI_INTERNAL_JWT_AUDIENCE=triage-ai
PS_TRIAGEAI_INTERNAL_ALLOWED_CALLERS=resolution
PS_TRIAGEAI_AUDIT_PUSH_URL=
PS_TRIAGEAI_INTERNAL_EVENT_HMAC_KEY=
PS_TRIAGEAI_SERVICE_NAME=triage-ai
PS_TRIAGEAI_LOG_LEVEL=INFO
