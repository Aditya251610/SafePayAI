# shopping-agent -- placeholders only, no real secrets. Names match deployment.md section 4
# and spec.md section 10 exactly. Never commit real values.

PS_SHOPPINGAGENT_SERVICE_NAME=shopping-agent
PS_SHOPPINGAGENT_LOG_LEVEL=info

PS_SHOPPINGAGENT_LLM_ENABLED=true
PS_SHOPPINGAGENT_LLM_PROVIDER=gemini
PS_SHOPPINGAGENT_LLM_FALLBACK_PROVIDER=groq
PS_SHOPPINGAGENT_LLM_MODEL_CART=changeme
PS_SHOPPINGAGENT_LLM_MODEL_CART_FALLBACK=changeme
PS_SHOPPINGAGENT_LLM_MODEL_FIT=changeme
PS_SHOPPINGAGENT_LLM_MODEL_FIT_FALLBACK=changeme
# Present only in the `ai` process env; never in core/edge/paypal (ADR-010).
PS_SHOPPINGAGENT_GEMINI_API_KEY=changeme
PS_SHOPPINGAGENT_GROQ_API_KEY=changeme
PS_SHOPPINGAGENT_LLM_TIMEOUT_CART_S=6
PS_SHOPPINGAGENT_LLM_TIMEOUT_FIT_S=4
PS_SHOPPINGAGENT_LLM_WALL_BUDGET_S=8
PS_SHOPPINGAGENT_LLM_TEMPERATURE_CART=0
PS_SHOPPINGAGENT_LLM_TEMPERATURE_FIT=0
PS_SHOPPINGAGENT_LLM_MAX_OUTPUT_CART=400
PS_SHOPPINGAGENT_LLM_MAX_OUTPUT_FIT=200
PS_SHOPPINGAGENT_LLM_DAILY_CAP_PCT=70
PS_SHOPPINGAGENT_MAX_CART_CALLS=2
PS_SHOPPINGAGENT_MAX_FIT_CALLS=1
PS_SHOPPINGAGENT_INTENT_MAX_CHARS=500
PS_SHOPPINGAGENT_UNTRUSTED_MAX_CHARS=1000
PS_SHOPPINGAGENT_PROMPT_VERSION_CART=cart.v1
PS_SHOPPINGAGENT_PROMPT_VERSION_FIT=fit.v1
PS_SHOPPINGAGENT_CACHE_TTL_HOURS=24
PS_SHOPPINGAGENT_FIT_MIN_CONFIDENCE=0.6

PS_SHOPPINGAGENT_DATABASE_URL=postgresql+asyncpg://svc_agent:changeme@localhost:5432/artiq
# Added for Alembic's direct connection (data-architecture.md section 8).
PS_SHOPPINGAGENT_MIGRATION_DATABASE_URL=postgresql+asyncpg://mig_agent:changeme@localhost:5432/artiq

PS_SHOPPINGAGENT_CATALOG_BASE_URL=http://localhost:8000
PS_SHOPPINGAGENT_MANDATE_BASE_URL=http://localhost:8000
PS_SHOPPINGAGENT_AUDIT_EVENTS_URL=http://localhost:8000
PS_SHOPPINGAGENT_INTERNAL_JWKS_URL=http://localhost:8080/.well-known/jwks.json
PS_SHOPPINGAGENT_SERVICE_AUDIENCE=shopping-agent
