# Names only. Real values live in the hosting dashboard, never in this repo.
# The web app owns no secrets: no PayPal keys, no signing keys, no database URL.

# --- Client-exposed (NEXT_PUBLIC_ prefix: shipped in the browser bundle) ---

# The single base URL every API call is built from (lib/api/config.ts).
# Keep it same-origin ("/api"): the gateway session cookie is __Host- and
# first-party only.
NEXT_PUBLIC_PS_WEB_API_BASE=/api

# Comma-separated hosts the browser may be sent to for PayPal approval.
# Anything else is refused before navigating.
NEXT_PUBLIC_PS_WEB_PAYPAL_APPROVE_HOST_ALLOWLIST=www.sandbox.paypal.com

# --- Server-side only ---

# Where the /api rewrite sends requests: the deployed api-gateway base URL.
PS_WEB_GATEWAY_INTERNAL_URL=http://localhost:8000
