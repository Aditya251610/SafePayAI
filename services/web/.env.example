# services/web/.env.example
#
# Names only - real values live in Vercel's dashboard (Production/Preview
# scoped), never in this repo (deployment-zero-cost.md sec 6, deployment.md
# sec 3). web owns no secrets: no PAYPAL_*, no HMAC/JWT keys, no DB URL
# (service-map.md sec 2 "web... Owns: nothing").
#
# NEXT_PUBLIC_ prefix = shipped into the client bundle. Everything else is
# server-side only (Vercel rewrite/proxy layer), per spec.md sec 13.

# --- Client-exposed (NEXT_PUBLIC_) ---

# Enables demo-only controls: reset button, demo clock panel, scene
# shortcuts, judge quick-path. Should be "true" on the hosted demo alias.
NEXT_PUBLIC_PS_WEB_DEMO_MODE=true

# Display/debug label only for the same-origin /api rewrite target - NOT a
# cross-origin call target (spec.md sec 13). The actual proxy target is
# PS_WEB_GATEWAY_INTERNAL_URL below (server-side only).
NEXT_PUBLIC_PS_WEB_API_BASE=/api

# Comma-separated host allowlist for the open-redirect guard before
# navigating to PayPal's sandbox approve_url (spec.md sec 2.6/13).
NEXT_PUBLIC_PS_WEB_PAYPAL_APPROVE_HOST_ALLOWLIST=www.sandbox.paypal.com

# --- Server-side only (no NEXT_PUBLIC_ prefix - never in the client bundle) ---

# Vercel rewrite/proxy target: the Render-hosted api-gateway base URL.
# Production only; previews default to PS_WEB_API_MODE=mock instead
# (deployment.md sec 2/3, R9).
PS_WEB_GATEWAY_INTERNAL_URL=http://localhost:8000

# "live" | "mock". Production=live, Preview=mock by default (deployment.md
# sec 2/3). Mock mode uses MSW fixtures generated from the committed OpenAPI
# contract and must be tree-shaken out of the production bundle.
PS_WEB_API_MODE=mock

# Optional error tracking DSN (Sentry Developer, free tier). Leave blank to
# disable.
PS_WEB_SENTRY_DSN=
